# dev | production (anything other than "dev" enforces the JWT_SECRET checks below)
ENVIRONMENT=dev
# For ENVIRONMENT=dev this value is fine as-is. For anything else, generate a real
# secret first (`openssl rand -hex 32`) -- the app refuses to start otherwise. See
# docs/PRODUCTION.md.
JWT_SECRET=change-me-in-real-deployments

DATABASE_URL=postgresql+psycopg://khub:khub@localhost:5432/khub
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=document_chunks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
RATE_LIMIT_REDIS_URL=redis://localhost:6379/2

AI_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:1b
# Only read when AI_PROVIDER=mistral. Get a key at https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# console prints emails to logs (no credentials needed for local dev) | resend
EMAIL_PROVIDER=console
# Only read when EMAIL_PROVIDER=resend. Get a key at https://resend.com/
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@localhost
# Base URL the emailed links point at (the frontend, not the API).
FRONTEND_BASE_URL=http://localhost:5173
RATE_LIMIT_SIGNUP=5/hour
RATE_LIMIT_INVITE=30/hour
RATE_LIMIT_INVITE_PREVIEW=20/minute
RATE_LIMIT_PASSWORD_RESET=5/hour

GOOGLE_DRIVE_MODE=mock

# Google OAuth for the real Drive/Gmail connectors -- see README for the
# Google Cloud Console setup steps. Leave blank to stay on mock connectors.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8010/api/v1/connectors/google/oauth/callback

RAW_STORAGE_DIR=./data/raw
DOCUMENT_CONTENT_MODE=cached

# Comma-separated list of browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- docker-compose-only variables ---
# These are read by docker-compose.yml itself (not by the app directly) to
# template the postgres container and the DATABASE_URL passed into
# backend/celery. Change them before a real deployment; the "khub" defaults
# below match this file's DATABASE_URL and are fine for local dev.
POSTGRES_DB=khub
POSTGRES_USER=khub
POSTGRES_PASSWORD=khub
# Public domain the frontend's Caddy container serves. Left as "localhost",
# Caddy self-signs a local dev cert; set to a real domain (with 80/443
# reachable from the internet) for automatic Let's Encrypt TLS.
DOMAIN=localhost
